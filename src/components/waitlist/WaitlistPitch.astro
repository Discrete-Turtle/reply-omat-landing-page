---
/**
 * WaitlistPitch — left column of /waitlist (§ design handoff left column).
 * Badge + italic-accent headline + sub + three perks. Static; no island.
 * `.badge`/`.dot` are redefined scoped here (the landing's copies live in
 * Hero.astro's scoped styles and aren't shared).
 */
---

<div class="pitch">
  <div class="badge">
    <span class="dot" aria-hidden="true"></span>
    Invite-only beta
  </div>

  <h1 class="wl-h1">Join the <em class="wl-accent">waitlist.</em></h1>

  <p class="wl-lead">
    We're onboarding a small group of owners at a time so we can set up each
    account properly. Tell us about your business and we'll be in touch.
  </p>

  <div class="perks">
    <div class="perk">
      <span class="pico" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
      </span>
      <div>
        <div class="perk-title">Free through the beta</div>
        <div class="perk-body">No card, no commitment. Keep a founding-member rate afterwards.</div>
      </div>
    </div>
    <div class="perk">
      <span class="pico" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>
      </span>
      <div>
        <div class="perk-title">We set up your voice with you</div>
        <div class="perk-body">A short call to tune the drafts so they actually sound like your place.</div>
      </div>
    </div>
    <div class="perk">
      <span class="pico" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
      </span>
      <div>
        <div class="perk-title">Nothing posts without you</div>
        <div class="perk-body">Every reply waits for your approval, in the beta and after.</div>
      </div>
    </div>
  </div>
</div>

<style>
  .pitch {
    position: relative;
    max-width: 460px;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--chip);
    border: 1px solid var(--chip-bd);
    color: var(--accent-tx);
    font: 600 12.5px var(--font-sans);
    padding: 7px 14px;
    border-radius: 99px;
    margin-bottom: 20px;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--primary);
    animation: wl-pulse 2s ease-in-out infinite;
  }
  @keyframes wl-pulse {
    0%, 100% { opacity: .4; }
    50% { opacity: 1; }
  }
  .wl-h1 {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.06;
    font-size: clamp(34px, 4.4vw, 50px);
    color: var(--ink);
    margin: 0 0 16px;
  }
  .wl-accent {
    font-style: italic;
    color: var(--primary);
  }
  .wl-lead {
    font-size: 17px;
    line-height: 1.6;
    color: var(--t2);
    margin: 0 0 32px;
  }
  .perks {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .perk {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .pico {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--chip);
    color: var(--accent-tx);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    line-height: 0;
  }
  .perk-title {
    font: 700 15px var(--font-sans);
    color: var(--ink);
    margin-bottom: 3px;
  }
  .perk-body {
    font-size: 14px;
    line-height: 1.55;
    color: var(--t2);
  }
  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
  }
</style>
