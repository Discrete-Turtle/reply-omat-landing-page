---
/**
 * Pricing — 3-tier plan grid (§5 of the design handoff).
 *
 * `repeat(3,1fr)` above 900px, collapsing to a single centered column below
 * it — note this section's breakpoint is 900px, unlike the 860px used by
 * Features/How-it-works. The middle "Growth" tier is highlighted with a
 * primary border, elevated shadow, and a "Most popular" tag.
 *
 * `.reveal` elements fade+rise in once via IntersectionObserver, scoped to
 * this section's DOM subtree — see Features.astro for the same pattern.
 */
---

<section id="pricing" class="w-full py-16 min-[860px]:py-[74px]">
  <div class="mx-auto max-w-[1200px] px-5 min-[860px]:px-7">
    <div class="reveal text-center max-w-[560px] mx-auto mb-11">
      <div class="eyebrow mb-[14px]">Pricing</div>
      <h2 class="text-ink text-[clamp(30px,3.6vw,44px)] mb-3">
        Simple plans that grow with you.
      </h2>
      <p class="m-0 text-t2 text-[16px]">
        Start free in the beta. Upgrade when the reviews pile up.
      </p>
    </div>

    <div class="price-grid grid grid-cols-1 min-[900px]:grid-cols-3 gap-[18px] items-stretch">
      <div class="price reveal flex flex-col">
        <div class="ptier text-t3">Starter</div>
        <div class="pprice">€0</div>
        <div class="psub text-t3">1 location &middot; 30 replies / mo</div>
        <div class="pfeat flex-1">
          <div class="pfeat-row">
            <span class="tick" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
            </span>
            One Google location
          </div>
          <div class="pfeat-row">
            <span class="tick" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
            </span>
            Tone control
          </div>
          <div class="pfeat-row">
            <span class="tick" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
            </span>
            Approve &amp; publish
          </div>
        </div>
        <button type="button" class="btn-ghost justify-center">Get Early Access</button>
      </div>

      <div class="price hot reveal flex flex-col relative">
        <div class="ptag">Most popular</div>
        <div class="ptier ptier-hot">Growth</div>
        <div class="pprice">€29<span class="pmo">/mo</span></div>
        <div class="psub text-t3">Up to 5 locations &middot; unlimited replies</div>
        <div class="pfeat flex-1">
          <div class="pfeat-row">
            <span class="tick" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
            </span>
            Up to 5 locations
          </div>
          <div class="pfeat-row">
            <span class="tick" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
            </span>
            Unlimited replies
          </div>
          <div class="pfeat-row">
            <span class="tick" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
            </span>
            Team members &amp; roles
          </div>
          <div class="pfeat-row">
            <span class="tick" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
            </span>
            Priority drafting
          </div>
        </div>
        <button type="button" class="btn-primary justify-center">Get Early Access</button>
      </div>

      <div class="price reveal flex flex-col">
        <div class="ptier text-t3">Enterprise</div>
        <div class="pprice">Custom</div>
        <div class="psub text-t3">Chains &amp; franchises</div>
        <div class="pfeat flex-1">
          <div class="pfeat-row">
            <span class="tick" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
            </span>
            Unlimited locations
          </div>
          <div class="pfeat-row">
            <span class="tick" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
            </span>
            SSO &amp; audit log
          </div>
          <div class="pfeat-row">
            <span class="tick" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
            </span>
            Dedicated support
          </div>
        </div>
        <button type="button" class="btn-ghost justify-center">Contact us</button>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 899.98px) {
    .price-grid {
      max-width: 440px;
      margin: 0 auto;
    }
  }

  .price {
    background: var(--card);
    border: 1px solid var(--b08);
    border-radius: 18px;
    padding: 30px;
    transition: transform 0.26s var(--ease-snap), box-shadow 0.26s;
  }
  .price:hover {
    transform: translateY(-3px);
  }
  .price.hot {
    border-color: var(--primary);
    box-shadow: 0 30px 60px -34px rgba(194, 105, 63, 0.6);
  }

  .ptag {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--primary);
    color: var(--pf);
    font: 700 11px var(--font-eyebrow);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 99px;
  }

  .ptier {
    font: 600 14px var(--font-eyebrow);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ptier-hot {
    color: var(--accent-tx);
  }

  .pprice {
    margin: 14px 0 4px;
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 500;
    color: var(--ink);
  }
  .pmo {
    font-size: 16px;
    font-family: var(--font-sans);
    font-weight: 400;
    color: var(--t3);
  }

  .psub {
    font-size: 13.5px;
    margin-bottom: 20px;
  }

  .pfeat {
    display: flex;
    flex-direction: column;
    gap: 11px;
    font-size: 14px;
    color: var(--t1);
  }
  .pfeat-row {
    display: flex;
    align-items: flex-start;
    gap: 9px;
  }
  .tick {
    color: var(--ok);
    flex-shrink: 0;
    line-height: 0;
    margin-top: 3px;
  }

  .btn-primary,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 700 15px var(--font-sans);
    padding: 14px 22px;
    border-radius: 11px;
    cursor: pointer;
    margin-top: 24px;
  }
  .btn-primary {
    border: none;
    background: var(--primary);
    color: var(--pf);
    box-shadow: var(--pshadow);
    transition: transform 0.26s var(--ease-snap), background 0.2s;
  }
  .btn-primary:hover {
    background: var(--primary-h);
    transform: translateY(-2px);
  }
  .btn-ghost {
    border: 1px solid var(--b16);
    background: var(--card);
    color: var(--t1);
    font-weight: 600;
    transition: background 0.22s, border-color 0.22s;
  }
  .btn-ghost:hover {
    background: var(--hover);
    border-color: var(--b28);
  }

  @media (prefers-reduced-motion: reduce) {
    .price,
    .btn-primary,
    .btn-ghost {
      transition: none;
    }
    .price:hover,
    .btn-primary:hover {
      transform: none;
    }
  }
</style>

<script>
  ;(function () {
    const root = document.getElementById("pricing")
    if (!root) return
    const reveals = root.querySelectorAll<HTMLElement>(".reveal")
    if (!reveals.length) return

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in")
            obs.unobserve(entry.target)
          }
        })
      },
      { threshold: 0.15 }
    )
    reveals.forEach((el) => observer.observe(el))
  })()
</script>
