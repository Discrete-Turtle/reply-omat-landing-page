---
/**
 * Features — bento grid (§3 of the design handoff).
 *
 * Four cells of varied size: a tall "Brand tone control" cell, two square
 * cells (Approve & publish, Multi-location), and a wide "Every review,
 * automatically" cell. Icons are hand-inlined SVGs (lucide path data) to
 * avoid pulling in the lucide-react runtime for four static icons.
 *
 * `.reveal` elements fade+rise in once via IntersectionObserver, scoped to
 * this section's DOM subtree. Under `prefers-reduced-motion` the observer is
 * skipped entirely — `.reveal` already renders fully visible via the
 * reduced-motion override in global.css.
 */
---

<section id="features" class="w-full py-16 min-[860px]:py-[74px]">
  <div class="mx-auto max-w-[1200px] px-5 min-[860px]:px-7">
    <div class="reveal mb-10 max-w-[640px]">
      <div class="eyebrow mb-[14px]">Everything, in your voice</div>
      <h2 class="text-ink text-[clamp(30px,3.6vw,44px)]">
        Built for owners who don't have time to babysit reviews.
      </h2>
    </div>

    <div class="feat-grid grid grid-cols-1 min-[860px]:grid-cols-[1.4fr_1fr_1fr] gap-4 min-[860px]:auto-rows-fr">
      <div class="feat reveal min-[860px]:row-span-2 flex flex-col justify-between">
        <div>
          <div class="ficon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"></path>
            </svg>
          </div>
          <h3 class="text-ink text-[21px] font-bold mb-2">Brand tone control</h3>
          <p class="m-0 text-t2 text-[15px] leading-[1.6]">
            Tell ReplyOmat about your place once and pick a voice, warm, brief, or formal. Every
            draft sounds like you wrote it, not a bot.
          </p>
        </div>
        <div class="mt-[22px] flex flex-wrap gap-2">
          <span class="pill pill-active">Warm</span>
          <span class="pill">Brief</span>
          <span class="pill">Formal</span>
        </div>
      </div>

      <div class="feat reveal">
        <div class="ficon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6L9 17l-5-5"></path>
          </svg>
        </div>
        <h3 class="text-ink text-[18px] font-bold mb-[7px]">Approve &amp; publish</h3>
        <p class="m-0 text-t2 text-[14px] leading-[1.55]">
          One tap from draft to live on Google. No copy-paste, no tab juggling.
        </p>
      </div>

      <div class="feat reveal">
        <div class="ficon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </div>
        <h3 class="text-ink text-[18px] font-bold mb-[7px]">Multi-location</h3>
        <p class="m-0 text-t2 text-[14px] leading-[1.55]">
          Run every storefront from one place, each with its own voice and team.
        </p>
      </div>

      <div class="feat reveal min-[860px]:col-span-2 flex gap-[18px] items-center">
        <div class="ficon mb-0 shrink-0">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 12h-6l-2 3h-4l-2-3H2"></path>
            <path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
          </svg>
        </div>
        <div>
          <h3 class="text-ink text-[18px] font-bold mb-[6px]">Every review, automatically</h3>
          <p class="m-0 text-t2 text-[14px] leading-[1.55]">
            Connected straight to your Google Business profile, so new reviews land in ReplyOmat
            the moment they're posted. Nothing to import, nothing to check.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .feat {
    background: var(--card);
    border: 1px solid var(--b08);
    border-radius: 17px;
    padding: 26px;
    transition: transform 0.26s var(--ease-snap), border-color 0.26s, box-shadow 0.26s;
  }
  .feat:hover {
    transform: translateY(-3px);
    border-color: var(--chip-bd);
    box-shadow: 0 22px 44px -30px rgba(34, 30, 25, 0.5);
  }

  .ficon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--chip);
    color: var(--accent-tx);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .pill {
    background: var(--inset);
    border: 1px solid var(--b12);
    color: var(--t3);
    font: 600 12.5px var(--font-sans);
    padding: 7px 13px;
    border-radius: 99px;
  }
  .pill-active {
    background: var(--chip);
    border-color: var(--chip-bd);
    color: var(--accent-tx);
  }

  @media (prefers-reduced-motion: reduce) {
    .feat {
      transition: none;
    }
    .feat:hover {
      transform: none;
    }
  }
</style>

<script>
  ;(function () {
    const root = document.getElementById("features")
    if (!root) return
    const reveals = root.querySelectorAll<HTMLElement>(".reveal")
    if (!reveals.length) return

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in")
            obs.unobserve(entry.target)
          }
        })
      },
      { threshold: 0.15 }
    )
    reveals.forEach((el) => observer.observe(el))
  })()
</script>
