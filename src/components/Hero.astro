---
/**
 * Hero — headline + animated "draft to published" product card.
 *
 * The card's cycling reply zone (label, spinner, typewriter text, action row)
 * is driven by a small vanilla-JS state machine below. The markup already
 * renders the reduced-motion end state ("Your draft" + Approve & publish +
 * Edit, full reply text, no cursor) so there's no flash of empty content and
 * `prefers-reduced-motion` users (or anyone whose JS hasn't run yet) see a
 * complete, correct card. When motion is allowed, the script takes over and
 * restarts the cycle from the "drafting" phase.
 *
 * Timer hygiene: the cycle is paused (all timers cleared) whenever the card
 * scrolls out of view or the tab is hidden, and resumed from the top when it
 * re-enters — a `running` guard means resume() never stacks a second chain
 * of timers on top of an existing one.
 *
 * Review rotation: REVIEWS holds ~10 demo entries (name/rating/meta/review/
 * reply). REVIEWS[0] is rendered directly into the SSR markup below — it's
 * both the reduced-motion end state and the first animated loop, so there's
 * no visible jump when the script takes over. REVIEWS is then handed to the
 * client script as inert JSON (a `<script type="application/json">` tag,
 * parsed via `JSON.parse` at the top of the state-machine script) rather
 * than via `define:vars`: `define:vars` skips Astro's normal esbuild/TS
 * pass for that script tag and inlines it as literal source, which broke
 * the existing TypeScript syntax below (`: number` annotations, `!`
 * non-null assertions, `as HTMLElement` casts) at runtime in the browser.
 * The JSON-tag approach keeps this script going through the same
 * TS-stripping pipeline it always has. The state machine advances to the
 * next entry (wrapping) once per full cycle, in phasePublished, right
 * before the next phaseDrafting call.
 */
interface ReviewEntry {
  name: string
  initial: string
  rating: number
  meta: string
  review: string
  reply: string
}

const REVIEWS: ReviewEntry[] = [
  {
    name: "Maria Sousa",
    initial: "M",
    rating: 5,
    meta: "Local Guide · 2 days ago",
    review: "Best fries in Porto! The truffle mayo is incredible and the staff were so friendly.",
    reply:
      "Thank you so much, Maria! The truffle mayo is our little obsession, so glad it won you over. See you next time!",
  },
  {
    name: "James Whitfield",
    initial: "J",
    rating: 5,
    meta: "4 days ago",
    review: "Stumbled in after a long walk and left completely won over by the garlic aioli fries.",
    reply: "Thanks so much, James! Garlic aioli really wins people over every time. Glad it hit the spot after your walk!",
  },
  {
    name: "Tiago Rocha",
    initial: "T",
    rating: 5,
    meta: "Local Guide · 6 days ago",
    review: "Perfect after a night out, the peri-peri sauce is dangerously addictive stuff.",
    reply: "Obrigado, Tiago! That peri-peri sauce truly has quite the reputation around here. See you again soon!",
  },
  {
    name: "Emma Clarke",
    initial: "E",
    rating: 4,
    meta: "1 week ago",
    review: "Great fries and lovely staff, though we did wait longer than expected at lunchtime.",
    reply: "Thanks, Emma! Sorry about the lunch wait, we're adding hands for peak hours. See you again soon!",
  },
  {
    name: "Rui Almeida",
    initial: "R",
    rating: 5,
    meta: "Local Guide · 1 week ago",
    review: "Came in skeptical about truffle fries and left a fully converted regular. Amazing stuff.",
    reply: "Conversion officially complete, Rui! Truffle fries do that to people every time. Thanks for the shot!",
  },
  {
    name: "Sophie Lindqvist",
    initial: "S",
    rating: 5,
    meta: "5 days ago",
    review: "Cosy little spot near the river, the fries were crunchy and every sauce was fantastic.",
    reply: "Thank you, Sophie! That riverside stroll pairs perfectly with our sauces. Come back anytime!",
  },
  {
    name: "Ana Ferreira",
    initial: "A",
    rating: 3,
    meta: "Local Guide · 3 days ago",
    review: "Fries were good but service was slow and our order got mixed up with another table's.",
    reply:
      "So sorry, Ana — that mix-up isn't the experience we want. We're fixing our flow and would love another chance!",
  },
  {
    name: "Marco Ferretti",
    initial: "M",
    rating: 5,
    meta: "2 weeks ago",
    review: "Best snack stop in Porto, hands down. The bacon cheddar fries are dangerously good.",
    reply: "Dangerously good is exactly what we're going for, Marco! Thanks for stopping by, see you again!",
  },
  {
    name: "Daniel O'Connor",
    initial: "D",
    rating: 4,
    meta: "3 weeks ago",
    review: "Solid fries and friendly service, just wish the portion sizes were a touch bigger.",
    reply: "Thanks, Daniel! Noted on portion size, we're reviewing that now. Glad the visit was a good one!",
  },
  {
    name: "Inês Pereira",
    initial: "I",
    rating: 5,
    meta: "Local Guide · 4 days ago",
    review: "Found this place by accident and it's now my go-to Porto snack stop. Love the house sauce.",
    reply: "Happy accidents are the best kind, Inês! Thrilled the house sauce won you over. See you soon!",
  },
]

// Split a rating into the exact gold/off glyph counts a rendered `.pc-stars`
// row needs. Used both for the SSR markup below (REVIEWS[0]) and mirrored
// in the client script (which can't import this — see the `define:vars`
// note above) so both render identically.
function starGlyphs(rating: number) {
  return {
    gold: "★".repeat(rating),
    off: "★".repeat(5 - rating),
  }
}

const firstReview = REVIEWS[0]
const firstStars = starGlyphs(firstReview.rating)
---

<section id="hero" class="relative w-full overflow-hidden" aria-label="Hero">
  <div class="absolute top-[44%] left-[64%] pointer-events-none" aria-hidden="true">
    <span class="ripple-ring"></span>
    <span class="ripple-ring ripple-d1"></span>
    <span class="ripple-ring ripple-d2"></span>
  </div>

  <div class="relative mx-auto grid max-w-[1200px] grid-cols-1 min-[860px]:grid-cols-[1.05fr_.95fr] gap-9 min-[860px]:gap-[52px] items-start min-[860px]:items-center px-5 min-[860px]:px-7 py-11 min-[860px]:py-[76px] pb-14 min-[860px]:pb-[84px]">
    <div class="max-w-[560px]">
      <div class="badge mb-[22px]">
        <span class="dot" aria-hidden="true"></span>
        Invite-only beta
      </div>

      <h1 class="text-ink text-[clamp(38px,5.4vw,66px)] mb-[22px]">
        Your reviews, answered <em class="accent-voice">in your <span class="accent-underline">voice.<svg class="swash" viewBox="0 0 120 16" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d="M4 10 Q 35 3 62 8 T 116 6"></path>
        </svg></span></em>
      </h1>

      <p class="mb-8 max-w-[480px] text-t2 text-[clamp(16px,1.4vw,19px)] leading-[1.6]">
        ReplyOmat drafts a warm, on-brand reply to every Google review the moment it lands. You
        read it, tweak it if you like, and publish straight to Google. One tap, no tab-juggling.
      </p>

      <div class="flex flex-wrap items-center gap-[14px]">
        <button type="button" class="btn-primary">
          Get Early Access
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </button>
        <a class="btn-ghost" href="#how-it-works">See how it works</a>
      </div>

      <div class="mt-[26px] flex items-center gap-[10px] text-t3 text-[13.5px]">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--ok)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 6L9 17l-5-5"></path>
        </svg>
        Nothing is posted without your approval.
      </div>
    </div>

    <div class="relative">
      <div id="hero-card" class="product-card">
        <div class="flex items-center gap-3">
          <div class="pc-avatar" id="hero-avatar" aria-hidden="true">{firstReview.initial}</div>
          <div class="flex-1 min-w-0">
            <div class="pc-name" id="hero-name">{firstReview.name}</div>
            <div class="pc-meta" id="hero-meta">{firstReview.meta}</div>
          </div>
          <span class="sr-only" id="hero-stars-sr">Rated {firstReview.rating} out of 5 stars.</span>
          <span class="pc-stars" id="hero-stars" aria-hidden="true"><span class="pc-star-gold">{firstStars.gold}</span><span class="pc-star-off">{firstStars.off}</span></span>
        </div>

        <p class="pc-review-text" id="hero-review-text">
          {firstReview.review}
        </p>

        <div class="pc-divider"></div>

        <div id="hero-cycle" aria-hidden="true">
          <div class="pc-reply-head">
            <span class="pc-mark"><span></span><span></span></span>
            <span class="eyebrow" id="hero-reply-label">Your draft</span>
            <span class="pc-spinner" id="hero-spinner" hidden></span>
          </div>

          <div class="pc-reply-box">
            <p class="pc-reply-text">
              <span id="hero-reply-typed">{firstReview.reply}</span><span class="pc-caret" id="hero-caret" hidden></span>
            </p>
          </div>

          <div class="pc-action-row" id="hero-action-row">
            <button type="button" tabindex="-1" class="pc-approve">Approve &amp; publish</button>
            <button type="button" tabindex="-1" class="pc-edit">Edit</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Headline accent — "voice." carries the italic Fraunces treatment (the
     surrounding <em> gives the whole clause the italic style; italic never
     affects line-wrapping) plus a hand-drawn gold swash underneath. The
     swash lives on the single word "voice." specifically — not the full
     three-word clause — because at the tested breakpoints (320–1440px) the
     headline wraps that clause differently at every width (sometimes
     "your voice." shares a line, sometimes "voice." sits alone); a single
     word never itself splits across a line-break, so it's the only anchor
     that can host a correctly-sized underline at every width without
     touching the sentence's existing wrap points.
   */
  .accent-voice {
    font-style: italic;
  }
  .accent-underline {
    position: relative;
    display: inline-block;
  }
  .accent-underline .swash {
    position: absolute;
    left: 0;
    top: 100%;
    width: 100%;
    height: 13px;
    overflow: visible;
  }
  .accent-underline .swash path {
    fill: none;
    stroke: var(--gold);
    stroke-width: 3;
    stroke-linecap: round;
  }
  /* No JS / no motion: the path above renders fully drawn, statically —
     nothing to gate. With JS, it starts hidden and draws in once on load. */
  html.js .accent-underline .swash path {
    stroke-dasharray: 114;
    stroke-dashoffset: 114;
    animation: swash-draw .9s var(--ease-snap) .5s forwards;
  }
  @keyframes swash-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html.js .accent-underline .swash path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--chip);
    border: 1px solid var(--chip-bd);
    color: var(--accent-tx);
    font: 600 12.5px var(--font-sans);
    padding: 7px 14px;
    border-radius: 99px;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--primary);
    animation: hero-pulse 2s ease-in-out infinite;
  }
  @keyframes hero-pulse {
    0%, 100% { opacity: .4; }
    50% { opacity: 1; }
  }

  .ripple-d1 { animation-delay: 2.33s; }
  .ripple-d2 { animation-delay: 4.66s; }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border: none;
    background: var(--primary);
    color: var(--pf);
    font: 700 15px var(--font-sans);
    padding: 14px 22px;
    border-radius: 11px;
    cursor: pointer;
    box-shadow: var(--pshadow);
    transition: transform 0.26s var(--ease-snap), background 0.2s;
  }
  .btn-primary:hover {
    background: var(--primary-h);
    transform: translateY(-2px);
  }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--b16);
    background: var(--card);
    color: var(--t1);
    font: 600 15px var(--font-sans);
    padding: 13px 20px;
    border-radius: 11px;
    cursor: pointer;
    transition: background 0.22s, border-color 0.22s;
  }
  .btn-ghost:hover {
    background: var(--hover);
    border-color: var(--b28);
  }

  .product-card {
    position: relative;
    background: var(--card);
    border: 1px solid var(--b08);
    border-radius: 17px;
    padding: 22px 22px 20px;
    box-shadow: 0 40px 80px -40px rgba(34, 30, 25, .5);
  }

  .pc-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    /* one-off avatar swatch from the pixel reference — not part of the clay token set */
    background: #e7ddcb;
    color: #704a22;
    display: flex;
    align-items: center;
    justify-content: center;
    font: 700 16px var(--font-sans);
    flex-shrink: 0;
  }
  /* .pc-name/.pc-meta are forced to a single line (nowrap + ellipsis,
     needing `min-w-0` on the flex-1 wrapper above so the flex item can
     actually shrink below its content width for overflow to kick in). This
     isn't cosmetic: at the 320px breakpoint the name/meta column is only
     ~83px wide, and letting either wrap would make its rendered line count
     content-dependent — some reviewer names wrap to 2 lines while others'
     "Local Guide · N days ago" meta wraps to 2 lines instead, and those two
     wrap patterns don't sum to the same total height. Forcing exactly one
     line each (truncating with an ellipsis if a given name/meta is too
     long for the column) is what keeps the card's height identical across
     all 10 rotating reviews. */
  .pc-name {
    font: 600 14.5px var(--font-sans);
    color: var(--ink);
  }
  .pc-meta {
    font-size: 12px;
    color: var(--t3);
  }
  .pc-stars {
    letter-spacing: 2px;
    font-size: 15px;
  }
  /* :global() is required here: the gold/off glyph spans are re-rendered at
     runtime via `starsEl.innerHTML = ...` each time the state machine
     advances to the next review (see the script below), so they never
     receive Astro's scoped `data-astro-cid-*` attribute. Declaring these
     as scoped rules would compile to `.pc-star-gold[data-astro-cid-xxxx]`,
     which matches the SSR-rendered first entry but silently stops matching
     the moment JS replaces that markup — same failure mode already fixed
     for `.pc-approve`/`.pc-edit`/`.pc-published` above. `:global()` matches
     both the initial scoped spans and every runtime-injected replacement. */
  :global(.pc-star-gold) {
    color: var(--gold);
  }
  :global(.pc-star-off) {
    color: var(--star-off);
  }
  .pc-review-text {
    margin: 14px 0 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--t1);
  }
  .pc-divider {
    margin: 18px 0;
    height: 1px;
    background: var(--b08);
  }

  .pc-mark {
    position: relative;
    display: inline-block;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
  .pc-mark span:first-child {
    position: absolute;
    top: 14%;
    left: 2%;
    width: 62%;
    height: 31%;
    border-radius: 3px;
    background: var(--star-off);
  }
  .pc-mark span:last-child {
    position: absolute;
    bottom: 14%;
    right: 2%;
    width: 76%;
    height: 31%;
    border-radius: 3px;
    background: var(--primary);
  }

  .pc-reply-head {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 11px;
  }
  /* Flex items shrink by default. At 320px the row (mark + label + spinner)
     is just wide enough that adding the spinner's width pushes the total
     past the container width, and the browser satisfies that by shrinking
     the label's box and wrapping its (uppercase, letter-spaced) text onto a
     second line — only while the spinner is visible, i.e. only during the
     first ~1.1s of every "Drafting a reply" phase. That silently doubled
     this row's height for that brief window, a per-loop layout shift this
     element (never re-created via innerHTML, so no :global() needed here)
     must not have. `flex-shrink: 0` and `white-space: nowrap` keep it at
     its natural single-line width regardless of what else is in the row.
  */
  .pc-spinner {
    width: 13px;
    height: 13px;
    border: 2px solid var(--b16);
    border-top-color: var(--primary);
    border-radius: 50%;
    display: inline-block;
    animation: hero-spin .7s linear infinite;
  }
  @keyframes hero-spin {
    to { transform: rotate(360deg); }
  }

  .pc-reply-box {
    min-height: 96px;
    background: var(--inset);
    border: 1px solid var(--b08);
    border-radius: 12px;
    padding: 14px 15px;
  }
  /* Below ~500px the card is narrow enough that a fully-typed 4-line reply
     (measured against the longest of the 10 rotating entries) no longer
     fits inside the 96px min-height used at wider widths — the box grows
     once typing finishes, then shrinks back to 96px on the next "Drafting
     a reply" phase (empty text), a small but real per-loop layout shift.
     Raising min-height here keeps the box pinned at its tallest content
     state across every phase and every rotating review at narrow widths,
     matching the "no layout shift" invariant already relied on at wider
     breakpoints (where 96px alone is already enough headroom). */
  @media (max-width: 480px) {
    .pc-name {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .pc-meta {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    #hero-reply-label {
      white-space: nowrap;
      flex-shrink: 0;
    }
    .pc-reply-box {
      min-height: 124px;
    }
  }
  .pc-reply-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.62;
    color: var(--t1);
  }
  .pc-caret {
    display: inline-block;
    width: 2px;
    height: 15px;
    background: var(--primary);
    vertical-align: -3px;
    margin-left: 1px;
    animation: hero-caret-blink .8s step-end infinite;
  }
  @keyframes hero-caret-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .pc-action-row {
    margin-top: 14px;
    height: 44px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  /* :global() is required here: this markup is injected at runtime via
     `actionRow.innerHTML = DRAFT_ACTIONS` in the state-machine script
     below, so the elements never receive Astro's scoped `data-astro-cid-*`
     attribute. A plain scoped `.pc-approve { ... }` rule compiles to
     `.pc-approve[data-astro-cid-xxxx] { ... }`, which silently never
     matches the dynamically-created button — it falls back to unstyled
     inline text instead of a primary clay button (same failure mode fixed
     for `.pc-published` above). The SSR-rendered reduced-motion end state
     (lines 96-99) carries the scoping attribute, but `:global()` matches
     it too, so both the static and JS-injected markup stay styled. */
  :global(.pc-approve) {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: none;
    background: var(--primary);
    color: var(--pf);
    font: 700 14px var(--font-sans);
    padding: 11px 14px;
    border-radius: 11px;
    cursor: pointer;
    box-shadow: var(--pshadow);
    transition: transform 0.26s var(--ease-snap), background 0.2s;
  }
  :global(.pc-approve:hover) {
    background: var(--primary-h);
    transform: translateY(-2px);
  }
  :global(.pc-edit) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--b16);
    background: var(--card);
    color: var(--t1);
    font: 600 14px var(--font-sans);
    padding: 11px 14px;
    border-radius: 11px;
    cursor: pointer;
    transition: background 0.22s, border-color 0.22s;
  }
  :global(.pc-edit:hover) {
    background: var(--hover);
    border-color: var(--b28);
  }
  /* :global() is required here: this markup is injected at runtime via
     `actionRow.innerHTML = PUBLISHED_CONFIRMATION` in the state-machine
     script below, so the element never receives Astro's scoped
     `data-astro-cid-*` attribute. A plain scoped `.pc-published { ... }`
     rule compiles to `.pc-published[data-astro-cid-xxxx] { ... }`, which
     silently never matches the dynamically-created div — it falls back to
     the SVG/text default block flow, stacking the check icon above the
     label instead of sitting inline with it. */
  :global(.pc-published) {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 9px;
    background: var(--ok-bg);
    color: var(--ok);
    border-radius: 10px;
    padding: 11px 14px;
    font: 600 13.5px var(--font-sans);
  }
  :global(.pc-published svg) {
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .dot,
    .pc-spinner,
    .pc-caret {
      animation: none;
    }
    .btn-primary,
    .pc-approve {
      transition: none;
    }
    .btn-primary:hover,
    .pc-approve:hover {
      transform: none;
    }
  }
</style>

<script type="application/json" id="hero-reviews-data" set:html={JSON.stringify(REVIEWS)}></script>
<script>
  ;(function () {
    const card = document.getElementById("hero-card")
    const labelEl = document.getElementById("hero-reply-label")
    const spinnerEl = document.getElementById("hero-spinner")
    const typedEl = document.getElementById("hero-reply-typed")
    const caretEl = document.getElementById("hero-caret")
    const actionRow = document.getElementById("hero-action-row")
    const avatarEl = document.getElementById("hero-avatar")
    const nameEl = document.getElementById("hero-name")
    const metaEl = document.getElementById("hero-meta")
    const starsEl = document.getElementById("hero-stars")
    const starsSrEl = document.getElementById("hero-stars-sr")
    const reviewTextEl = document.getElementById("hero-review-text")
    const reviewsDataEl = document.getElementById("hero-reviews-data")
    if (
      !card ||
      !labelEl ||
      !spinnerEl ||
      !typedEl ||
      !caretEl ||
      !actionRow ||
      !avatarEl ||
      !nameEl ||
      !metaEl ||
      !starsEl ||
      !starsSrEl ||
      !reviewTextEl ||
      !reviewsDataEl
    )
      return

    // The markup already renders this exact reduced-motion end state, so
    // there is nothing left to do when motion is disabled.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return

    type ReviewEntry = {
      initial: string
      name: string
      meta: string
      rating: number
      review: string
      reply: string
    }

    // Parsed from the inert JSON <script> tag above (see the frontmatter
    // doc comment for why it isn't passed via `define:vars`).
    let REVIEWS: ReviewEntry[]
    try {
      const parsed = JSON.parse(reviewsDataEl.textContent || "[]")
      if (!Array.isArray(parsed) || parsed.length === 0) {
        return
      }
      REVIEWS = parsed
    } catch {
      return
    }

    // REVIEWS[0] is already rendered into the SSR markup (avatar/name/meta/
    // stars/review text/reply), so the index starts at 0 to match it exactly
    // — the first animated loop is visually identical to the static
    // fallback. `reviewIndex` advances (wrapping) once per full cycle, in
    // phasePublished, right before the next phaseDrafting call. REPLY is a
    // `let`, not the original `const` read once from the DOM, because it
    // now changes every cycle along with the rest of the review.
    let reviewIndex = 0
    let REPLY = REVIEWS[reviewIndex].reply

    // Mirrors the `starGlyphs()` helper in the frontmatter above (that
    // helper only runs at build time; this runtime copy is what re-renders
    // `.pc-stars` — via innerHTML, hence :global() on the CSS side — every
    // time the state machine moves to the next review).
    function starsMarkup(rating: number) {
      return (
        `<span class="pc-star-gold">${"★".repeat(rating)}</span>` +
        `<span class="pc-star-off">${"★".repeat(5 - rating)}</span>`
      )
    }

    function applyReview(entry: ReviewEntry) {
      avatarEl!.textContent = entry.initial
      nameEl!.textContent = entry.name
      metaEl!.textContent = entry.meta
      starsSrEl!.textContent = `Rated ${entry.rating} out of 5 stars.`
      starsEl!.innerHTML = starsMarkup(entry.rating)
      reviewTextEl!.textContent = entry.review
      REPLY = entry.reply
    }

    // Same idea for the draft action buttons: the SSR markup (lines 96-99)
    // already renders the exact "Approve & publish" / "Edit" buttons this
    // phase needs, and at this point in the script nothing has touched
    // `actionRow` yet, so its current innerHTML *is* that markup. Capture it
    // here instead of hand-duplicating the button HTML in a template
    // literal, so there's one source of truth for the draft-actions markup.
    const DRAFT_ACTIONS = actionRow.innerHTML

    const PUBLISHED_CONFIRMATION = `
      <div class="pc-published">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 6L9 17l-5-5"></path>
        </svg>
        Published to Google
      </div>
    `

    const DRAFTING_DELAY_MS = 1100
    const TYPE_TICK_MS = 34
    const DRAFT_READY_DELAY_MS = 700
    const DRAFT_HOLD_MS = 1900
    const PUBLISHED_HOLD_MS = 2600

    let timers: number[] = []
    let typeIntervalId: number | null = null
    let running = false
    let inView = false

    function after(ms: number, fn: () => void) {
      timers.push(window.setTimeout(fn, ms))
    }

    function clearTimers() {
      timers.forEach((id) => window.clearTimeout(id))
      timers = []
      if (typeIntervalId !== null) {
        window.clearInterval(typeIntervalId)
        typeIntervalId = null
      }
    }

    function phaseDrafting() {
      // Show the review this cycle is drafting a reply for. On the very
      // first call this re-applies REVIEWS[0] (already on screen from SSR,
      // so it's a no-op visually); every subsequent call applies whichever
      // entry phasePublished advanced `reviewIndex` to.
      applyReview(REVIEWS[reviewIndex])
      labelEl!.textContent = "Drafting a reply"
      ;(spinnerEl as HTMLElement).hidden = false
      ;(caretEl as HTMLElement).hidden = true
      typedEl!.textContent = ""
      actionRow!.innerHTML = ""
      after(DRAFTING_DELAY_MS, phaseTyping)
    }

    function phaseTyping() {
      ;(spinnerEl as HTMLElement).hidden = true
      ;(caretEl as HTMLElement).hidden = false
      let shown = 0
      const step = Math.max(1, Math.round(REPLY.length / 60))
      typeIntervalId = window.setInterval(() => {
        shown += step
        if (shown >= REPLY.length) {
          typedEl!.textContent = REPLY
          window.clearInterval(typeIntervalId!)
          typeIntervalId = null
          after(DRAFT_READY_DELAY_MS, phaseDraft)
          return
        }
        typedEl!.textContent = REPLY.slice(0, shown)
      }, TYPE_TICK_MS)
    }

    function phaseDraft() {
      ;(caretEl as HTMLElement).hidden = true
      labelEl!.textContent = "Your draft"
      actionRow!.innerHTML = DRAFT_ACTIONS
      after(DRAFT_HOLD_MS, phasePublished)
    }

    function phasePublished() {
      actionRow!.innerHTML = PUBLISHED_CONFIRMATION
      // Advance to the next review now, before the hold — so the *next*
      // phaseDrafting() call (single chained timer, no second timer added)
      // picks up REVIEWS[reviewIndex + 1], wrapping back to 0 after the
      // last entry.
      reviewIndex = (reviewIndex + 1) % REVIEWS.length
      after(PUBLISHED_HOLD_MS, phaseDrafting)
    }

    // A single `running` guard means resume() is a no-op while a cycle is
    // already active, so re-entering the viewport or refocusing the tab
    // never stacks a second chain of timers on top of the existing one.
    function resume() {
      if (running) return
      running = true
      phaseDrafting()
    }

    function pause() {
      running = false
      clearTimers()
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          inView = entry.isIntersecting
          if (inView && !document.hidden) {
            resume()
          } else {
            pause()
          }
        })
      },
      { threshold: 0.2 }
    )
    observer.observe(card)

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        pause()
      } else if (inView) {
        resume()
      }
    })
  })()
</script>
