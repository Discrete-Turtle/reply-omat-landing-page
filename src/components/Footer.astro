---
import Logo from "./Logo.astro"

type FooterLink = {
  label: string
  href: string
}

const footerLinks: FooterLink[] = [
  { label: "Privacy Policy", href: "/privacy" },
  { label: "Terms of Service", href: "/terms" },
  { label: "Contact", href: "/contact" },
]
---

<footer class="ftr w-full">
  <div class="ftr-inner mx-auto max-w-[1200px] px-5 min-[860px]:px-7">
    <Logo size={22} />

    <nav aria-label="Footer" class="ftr-links">
      {footerLinks.map((link) => (
        <a class="navlink" href={link.href}>{link.label}</a>
      ))}
    </nav>

    <p class="ftr-copy">© 2026 ReplyOmat</p>
  </div>
</footer>

<style>
  .ftr {
    border-top: 1px solid var(--b08);
    padding: 34px 0;
  }

  .ftr-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    text-align: center;
  }
  @media (min-width: 520px) {
    .ftr-inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .ftr-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 18px;
  }
  @media (min-width: 520px) {
    .ftr-links {
      gap: 26px;
    }
  }

  .navlink {
    position: relative;
    padding: 4px 2px;
    font: 600 14px var(--font-sans);
    color: var(--t2);
    border-radius: 4px;
    transition: color 0.2s;
  }
  .navlink::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 0;
    height: 2px;
    background: var(--primary);
    transition: width 0.26s var(--ease-snap);
  }
  .navlink:hover {
    color: var(--ink);
  }
  .navlink:hover::after {
    width: 100%;
  }
  .navlink:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }

  .ftr-copy {
    margin: 0;
    color: var(--t4);
    font-size: 13px;
  }

  @media (prefers-reduced-motion: reduce) {
    .navlink::after {
      transition: none;
    }
  }
</style>
