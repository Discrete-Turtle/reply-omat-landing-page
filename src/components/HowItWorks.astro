---
/**
 * How it works — full-width `--board` band (§4 of the design handoff).
 *
 * 2-col layout (.85fr 1.15fr) with the left column (eyebrow + headline)
 * sticky above 860px, collapsing to a single static column below it. The
 * right column lists 3 numbered steps joined by a connecting line between
 * step 1→2 and 2→3 (no line trailing the last step).
 *
 * `.reveal` elements fade+rise in once via IntersectionObserver, scoped to
 * this section's DOM subtree — see Features.astro for the same pattern.
 */
---

<section id="how-it-works" class="w-full py-16 min-[860px]:py-[74px] bg-board">
  <div class="mx-auto max-w-[1200px] px-5 min-[860px]:px-7 how-grid grid grid-cols-1 min-[860px]:grid-cols-[.85fr_1.15fr] gap-8 min-[860px]:gap-14 items-start">
    <div class="reveal how-sticky min-[860px]:sticky min-[860px]:top-24">
      <div class="eyebrow mb-[14px]">How it works</div>
      <h2 class="text-ink text-[clamp(30px,3.6vw,44px)] mb-4">
        From new review to posted reply in about ten seconds.
      </h2>
      <p class="m-0 text-t2 text-[16px] leading-[1.6]">
        No dashboards to learn. You approve, we handle the rest.
      </p>
    </div>

    <div class="flex flex-col gap-[30px]">
      <div class="step reveal">
        <div class="stepline"></div>
        <div class="stepnum">1</div>
        <h3 class="text-ink text-[19px] font-bold mb-[7px]">A review lands</h3>
        <p class="m-0 text-t2 text-[15px] leading-[1.6]">
          ReplyOmat is connected to your Google Business profile and flags every new review
          waiting for a reply.
        </p>
      </div>

      <div class="step reveal">
        <div class="stepline"></div>
        <div class="stepnum">2</div>
        <h3 class="text-ink text-[19px] font-bold mb-[7px]">AI drafts it in your voice</h3>
        <p class="m-0 text-t2 text-[15px] leading-[1.6]">
          A personalized reply appears, matched to the review and your chosen tone. Not a
          template.
        </p>
      </div>

      <div class="step reveal">
        <div class="stepnum">3</div>
        <h3 class="text-ink text-[19px] font-bold mb-[7px]">You approve, it posts to Google</h3>
        <p class="m-0 text-t2 text-[15px] leading-[1.6]">
          Read it, tweak a word if you like, tap publish. It's live on your listing instantly.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .step {
    position: relative;
    padding-left: 64px;
  }
  .stepnum {
    position: absolute;
    left: 0;
    top: 0;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--card);
    border: 1px solid var(--chip-bd);
    color: var(--accent-tx);
    font: 700 18px var(--font-display);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }
  .stepline {
    position: absolute;
    left: 22.5px;
    top: 46px;
    bottom: -30px;
    width: 2px;
    background: linear-gradient(var(--chip-bd), transparent);
  }
</style>

<script>
  ;(function () {
    const root = document.getElementById("how-it-works")
    if (!root) return
    const reveals = root.querySelectorAll<HTMLElement>(".reveal")
    if (!reveals.length) return

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in")
            obs.unobserve(entry.target)
          }
        })
      },
      { threshold: 0.15 }
    )
    reveals.forEach((el) => observer.observe(el))
  })()
</script>
